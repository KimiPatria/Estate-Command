GROQ_API_KEY=your_key_here
DATABASE_URL=postgresql://username:password@host:5432/dbname
# Free NASA FIRMS map key (https://firms.modaps.eosdis.nasa.gov/api/map_key/) —
# powers the live fire-hotspot signal in forecast_intelligence.py. Without it,
# that signal degrades to "N/A (unavailable)" and the rest of the forecast
# intelligence analysis still runs.
FIRMS_MAP_KEY=
# --- multi-estate registry (Head Office chatbot: BA + K3) -------------------
# Second estate's database — same server/credentials as DATABASE_URL above,
# different database name. See config.ESTATES / estates.py.
DATABASE_URL_BA=postgresql://username:password@host:5432/dbname_ba
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_120B=openai/gpt-oss-120b
GROQ_MODEL_20B=openai/gpt-oss-20b
GROQ_MODEL_JUDGE=qwen/qwen3-32b
DEFAULT_PROVIDER=groq
MAX_RESULT_ROWS=100
STATEMENT_TIMEOUT_MS=15000
DB_SCHEMA=public

# --- dynamic routing (iteration 2) ---
ROUTING_MODEL=llama-3.1-8b-instant
CATALOG_TTL_SECONDS=1800
MAX_ROUTED_TABLES=12
GLOSSARY_PATH=./glossary.yaml

# --- LLM infrastructure provider (Bedrock migration seam) ---------------------
# These keys are INERT until AWS/Bedrock access exists. Leave LLM_PROVIDER=groq.
# When credentials land: set LLM_PROVIDER=bedrock, pick the Nova tier in
# BEDROCK_MODEL_ID, ensure AWS credentials are available (env/SSO profile),
# and restart. No code changes needed — see README "Switching LLM providers".
LLM_PROVIDER=groq
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_ROUTING_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-east-1
# Bedrock API key (bearer token) from AWS Console -> Amazon Bedrock -> API keys.
# boto3/botocore auto-detects this env var; no IAM access key pair needed.
AWS_BEARER_TOKEN_BEDROCK=

# Structured per-LLM-call log (JSONL: task, provider, model, tokens, latency).
# Set empty to disable.
LLM_LOG_PATH=./llm_calls.jsonl

# --- manual RAG source toggle (SQL vs. Bedrock Knowledge Base, POC) -----------
# "sql" | "knowledge_base" | "both". Overridable per-request (ChatRequest.source).
# No automatic routing yet — see rag_sources.py.
RAG_SOURCE_DEFAULT=sql
# Set once infra/terraform/bedrock_kb.tf (NOT YET APPLIED) has been applied.
BEDROCK_KB_ID=
# Defaults to BEDROCK_MODEL_ID if unset.
BEDROCK_KB_MODEL_ID=
# Chunks retrieved per KB query — the main token-cost lever on this path.
KB_TOP_K=5
# Structured per-request RAG log (JSONL: source, route, llm_calls, tokens, latency).
RAG_LOG_PATH=./rag_calls.jsonl
